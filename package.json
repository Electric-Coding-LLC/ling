{
  "name": "ling",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build --prerender-all && node scripts/package-static-home.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run audio:verify:grammar && npm run audio:verify:vocabulary && npm run test",
    "audio:generate:curriculum": "node --experimental-strip-types scripts/generate-curriculum-vocabulary-audio.mjs",
    "audio:generate:grammar": "node --experimental-strip-types scripts/generate-grammar-audio.mjs",
    "audio:generate:vocabulary": "node scripts/generate-vocabulary-audio.mjs",
    "audio:verify:grammar": "node --experimental-strip-types scripts/verify-grammar-audio.mjs",
    "audio:verify:pitch": "node --experimental-strip-types scripts/verify-pitch-audio.mjs",
    "audio:verify:travel": "node --experimental-strip-types scripts/verify-travel-audio.mjs",
    "audio:verify:vocabulary": "node --experimental-strip-types scripts/verify-vocabulary-audio.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state --config wrangler.local.jsonc"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260801.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "type": "module"
}
